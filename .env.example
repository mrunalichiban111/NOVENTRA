APP_ENV=
MOCK_LLM=
DATABASE_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
ANTHROPIC_API_KEY=
# Model ids: claude-sonnet-5-5 (strong) and claude-haiku-5-5 (small); see docs/llm.md
CLAUDE_MODEL_STRONG=
CLAUDE_MODEL_SMALL=
GODADDY_PAT=
# Comma-separated TLDs checked read-only for the top five names (default in,com,co)
GODADDY_TLDS=in,com,co
# 1/true = deterministic offline domain results; empty = follow MOCK_LLM
DOMAIN_CHECK_MOCK=
# Apex for claimed subdomains (<slug>.<BASE_DOMAIN>); name selection returns 503 while empty
BASE_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAILBOX_TO=
PER_RUN_CAP_USD=2.00
FIXTURES_DIR=
DAILY_SPEND_CAP_USD=
SECRET_KEY=
TEST_DATABASE_URL=
WORKER_POLL_SECONDS=
WORKER_CLAIM_TTL_SECONDS=
MAX_STAGE_ATTEMPTS=
RATE_LIMIT_PER_MINUTE=
TRUSTED_PROXY_IPS=
APP_DB_USER=
APP_DB_PASSWORD=
# --- M4B site generation and deployment (docs/deploy.md) ---
# Empty = deployment off (deploy requests return 503). mock | local. mock is refused in production.
DEPLOY_PROVIDER=
# Outside Docker only; Compose pins the worker to /srv/sites. Default ./sites (repo root).
SITES_ROOT=
# skip | mock | preconfigured (read-only lookup; never creates DNS records)
SITE_DNS_MODE=skip
# 1/true = verify https://<host>/ serves the release (needs SITE_DNS_MODE=preconfigured)
SITE_HTTP_CHECK=
# One deadline (seconds) shared by DNS and HTTPS verification
SITE_HEALTH_TIMEOUT_S=60
# 1/true = LIVE requires public verification. Always on when APP_ENV=production.
SITE_REQUIRE_PUBLIC=
# Plain https URL the waitlist form posts to; empty = no form rendered
WAITLIST_POST_URL=
# Address for the "Report abuse" link on every site; empty = link omitted
ABUSE_REPORT_EMAIL=
# Secret bearer token for the internal Caddy TLS permission check; empty = endpoint disabled
INTERNAL_TLS_ASK_TOKEN=
# Public contact delivery; placeholders only.
SMTP_USE_SSL=
SMTP_STARTTLS=
CONTACT_TO=
CONTACT_FROM=
